{
  "name": "magpie-ducoro",
  "version": "0.4.2",
  "description": "Sync Magpie models, connectors, skills and instructions with Ducoro.",
  "type": "module",
  "main": "./bridge.mjs",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "ducoro",
    "provider",
    "auth"
  ],
  "license": "MIT",
  "magpie": {
    "name": "Ducoro",
    "icon": "data:image/svg+xml;base64,",
    "agent": "./ducoro.agent.js",
    "summary": {
      "en": "Sync Magpie models, connectors and skills with Ducoro.",
      "zh": "将 Magpie 的模型、连接器与技能同步到 Ducoro。"
    },
    "options": {
      "connectionSlug": "magpie-ducoro",
      "syncConnection": true,
      "syncMcp": true,
      "syncSkills": true,
      "skillsScope": "global",
      "prune": true,
      "onDisconnect": "keep",
      "syncInstructions": true,
      "syncSubagents": true,
      "targetAgents": [],
      "subagentNames": [],
      "syncAgentModels": true,
      "modelCapabilityRefs": {},
      "officialProviders": [
        "zai",
        "zai-coding-cn",
        "kimi-coding",
        "moonshotai",
        "moonshotai-cn",
        "anthropic",
        "openai",
        "google",
        "deepseek",
        "xai",
        "minimax",
        "minimax-cn",
        "alibaba",
        "alibaba-cn"
      ],
      "mcpScope": "global",
      "resourceAssignments": {},
      "modelScope": "global",
      "botModels": {},
      "accountConnectors": {},
      "servicePort": 3487,
      "accountResolutions": {},
      "botPlansCatalog": {},
      "botPlans": {},
      "botInstructions": {},
      "pausedModels": [],
      "modelGuards": {}
    },
    "page": {
      "title": "Ducoro",
      "file": "ui/launch.html",
      "titles": {
        "zh": "Ducoro"
      },
      "service": {
        "port": 3487,
        "option": "servicePort"
      }
    }
  },
  "files": [
    "bridge.mjs",
    "ducoro.agent.js",
    "assets/",
    "total.mjs",
    "model-sync.mjs",
    "model-capabilities.mjs",
    "CHANGELOG.md",
    "options.mjs",
    "diagnostics.mjs",
    "diagnostics-cli.mjs",
    "ui/",
    "resource-scopes.mjs",
    "README.zh-CN.md",
    "page-service.mjs",
    "account-connectors.mjs",
    "account-plan.mjs",
    "sync-preview.mjs",
    "state-store.mjs",
    "watch-fallback.mjs",
    "inventory-shapes.mjs",
    "command-runner.mjs",
    "verification.mjs",
    "content-preview.mjs",
    "performance.mjs",
    "file-cache.mjs",
    "control-center.mjs"
  ],
  "scripts": {
    "diagnostics": "node diagnostics-cli.mjs"
  },
  "bin": {
    "magpie-ducoro-status": "./diagnostics-cli.mjs"
  }
}
